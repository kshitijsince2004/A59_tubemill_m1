# postgresql.conf snippets for Zedral on 16 GB / 2 cores (illustrative — merge into data dir conf)
listen_addresses = 'localhost'
port = 5432
max_connections = 100
shared_buffers = 2GB
effective_cache_size = 8GB
work_mem = 16MB
maintenance_work_mem = 256MB
max_parallel_workers_per_gather = 1
max_worker_processes = 2
wal_level = replica
archive_mode = on
# archive_command set by Install / Backup scripts to call archive_wal.ps1
log_min_duration_statement = 1000
log_line_prefix = '%m [%p] %u@%d '
