{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd Code && npm install",
  "buildCommand": "cd Code && npm run build -w shared && npm run build -w client",
  "outputDirectory": "Code/client/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
