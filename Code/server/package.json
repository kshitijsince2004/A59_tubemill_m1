{
  "name": "@a59/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx concurrently -k -n babel,server -c yellow,blue \"babel src --out-dir dist --extensions .js --config-file ../babel.build.cjs --copy-files -w\" \"node --watch dist/index.js\"",
    "build": "babel src --out-dir dist --extensions .js --config-file ../babel.build.cjs --copy-files",
    "start": "node dist/index.js",
    "migrate": "npm run build && node dist/db/migrate.js",
    "seed": "npm run build && node dist/db/seed.js",
    "verify:rls": "npm run build && node dist/verify-rls.js",
    "verify:rbac": "npm run build && node dist/verify-rbac.js",
    "smoke:machine-head": "npm run build && node dist/smoke-machine-head.js",
    "smoke:crew": "npm run build && node dist/smoke-crew.js",
    "smoke:handover": "npm run build && node dist/smoke-handover.js",
    "smoke:plant-head": "npm run build && node dist/smoke-plant-head.js",
    "smoke:dashboard-graphs": "npm run build && node dist/smoke-dashboard-graphs.js",
    "smoke:api-inventory": "npm run build && node dist/smoke-api-inventory.js",
    "verify:phases": "npm run build && node dist/verify-phases.js",
    "verify:state-machine": "npm run build && node dist/verify-state-machine.js",
    "check:migration-parity": "node scripts/check-migration-parity.mjs",
    "check:sql-encoding": "node scripts/check-sql-encoding.mjs",
    "smoke:unauth": "node scripts/smoke-unauth-401.mjs",
    "cleanup:retention": "node scripts/cleanup-retention.mjs"
  },
  "dependencies": {
    "@a59/shared": "*",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "serverless-http": "^4.0.0",
    "supertokens-node": "^21.1.0"
  }
}
