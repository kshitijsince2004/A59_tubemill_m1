# Migrate/seed need the owner role (tubemill). For RLS-faithful app runs (H-2), prefer:
# DATABASE_URL=postgresql://m1_app:m1_app@localhost:5433/tubemill
DATABASE_URL=postgresql://tubemill:tubemill@localhost:5433/tubemill
PORT=3001
TENANT_ID=00000000-0000-4000-8000-000000000001
COLLECTOR_MODE=sim
BC_ADAPTER=file
# Future OData (unused until BC UAT + custom API pages — OQ-03):
# BC_BASE_URL=
# BC_TENANT=
# BC_CLIENT_ID=
# BC_CLIENT_SECRET=
SERVICE_TOKEN=dev-service-token
YIELD_TOLERANCE_PCT=2
AUTH_MODE=dev
# AUTH_STRICT=false
# AUTH_ALLOW_HEADER_ROLE=true
#
# SuperTokens Core (docker compose service `supertokens` on :3567)
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
# SUPERTOKENS_API_KEY=
API_DOMAIN=http://localhost:3001
WEBSITE_DOMAIN=http://localhost:5173
API_BASE_PATH=/auth
WEBSITE_BASE_PATH=/auth
#
# STATIC_APP_ROLE=OPERATOR
# CORS_ORIGIN=*
# BC_PLAN_PATH=
# COLLECTOR_DRIVE=on_demand
#
# Netlify: set SUPERTOKENS_CONNECTION_URI to a managed SuperTokens Core URL
# (or self-hosted). Set AUTH_ALLOW_HEADER_ROLE=false and AUTH_STRICT=true.
# Unauthenticated API calls return 401.
# Client still uses apiBasePath /api/auth; Vite/Netlify rewrite /api → '' so Core sees /auth.
# Netlify Database connection is injected via NETLIFY_DATABASE_URL / @netlify/database.
