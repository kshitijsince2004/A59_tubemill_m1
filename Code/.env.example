AUTH_MODE=dev
COLLECTOR_MODE=sim

# Database — Netlify sets NETLIFY_DB_URL automatically when Database is linked.
# Local Docker:
# DATABASE_URL=postgresql://m1_app:m1_app@localhost:5433/tubemill
# NETLIFY_DB_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

PORT=3001

# Non-default recommended on Netlify (also used to HMAC demo sessions if SESSION_SECRET unset)
SERVICE_TOKEN=dev-service-token
# SESSION_SECRET=  # optional dedicated HMAC key for demo sessions

TENANT_ID=00000000-0000-4000-8000-000000000001

YIELD_TOLERANCE_PCT=2

# Optional SuperTokens Core (managed SaaS or self-hosted).
# If unset on Netlify, badge/PIN uses built-in HMAC demo sessions (EmailPassword staff login needs ST).
# SUPERTOKENS_CONNECTION_URI=https://try.supertokens.com
# SUPERTOKENS_API_KEY=
# API_DOMAIN=https://your-site.netlify.app
# WEBSITE_DOMAIN=https://your-site.netlify.app
